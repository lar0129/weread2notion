WEREAD_API_KEY=

# Notion internal connection token：https://www.notion.so/profile/integrations
NOTION_TOKEN=

# 复制模板并授权后，填写你自己的“数据库”链接（不是外层普通页面链接）。
# 模板：https://malinkang.notion.site/weread2notion
NOTION_PAGE=

# 同一数据库存在多个表时，指定实际同步的 data source；由初始化步骤填写。
NOTION_DATA_SOURCE_ID=
